# Set these in Netlify or Vercel's encrypted environment-variable settings.
# Never commit a real value in this file or anywhere in Git.

# Secure CMS/admin authentication (server only)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Airtable CMS (server only)
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Content
AIRTABLE_PLAYERS_TABLE=Players

# Image upload storage (server only)
BLOB_READ_WRITE_TOKEN=

# Public, non-secret analytics / verification identifiers
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
